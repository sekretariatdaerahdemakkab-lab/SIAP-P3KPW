{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account metadata",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "description": "User role in system"
        },
        "created_at": {
          "type": "string",
          "description": "ISO timestamp of account registration"
        }
      },
      "required": ["email", "role"]
    },
    "WorkHours": {
      "title": "WorkHours",
      "description": "Office work hours presets and tolerance configuration",
      "type": "object",
      "properties": {
        "active_id": {
          "type": "string",
          "description": "ID of currently active work schedule"
        },
        "jam_masuk": {
          "type": "string",
          "description": "Standard check-in time HH:mm of active schedule"
        },
        "jam_pulang": {
          "type": "string",
          "description": "Standard check-out time HH:mm of active schedule"
        },
        "toleransi_menit": {
          "type": "number",
          "description": "Late tolerance in minutes of active schedule"
        },
        "schedules": {
          "type": "array",
          "description": "List of available work schedule profiles"
        }
      },
      "required": ["jam_masuk", "jam_pulang", "toleransi_menit"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Master data for PPPK Paruh Waktu employees",
      "type": "object",
      "properties": {
        "nama": {
          "type": "string",
          "description": "Full name of employee"
        },
        "jabatan": {
          "type": "string",
          "description": "Official title or position"
        },
        "unit_kerja": {
          "type": "string",
          "description": "Work unit or section"
        }
      },
      "required": ["nama", "jabatan", "unit_kerja"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record per employee",
      "type": "object",
      "properties": {
        "nip": {
          "type": "string",
          "description": "Employee identification number (NIP)"
        },
        "tanggal": {
          "type": "string",
          "description": "Date of attendance YYYY-MM-DD"
        },
        "waktu_masuk": {
          "type": "string",
          "description": "Check-in time"
        },
        "waktu_keluar": {
          "type": "string",
          "description": "Check-out time"
        },
        "status": {
          "type": "string",
          "description": "Attendance status"
        },
        "total_jam": {
          "type": "number",
          "description": "Total effective work hours"
        }
      },
      "required": ["nip", "tanggal"]
    },
    "Holiday": {
      "title": "Holiday",
      "description": "National holidays and collective leaves (Cuti Bersama)",
      "type": "object",
      "properties": {
        "tanggal": {
          "type": "string",
          "description": "Holiday date YYYY-MM-DD"
        },
        "nama": {
          "type": "string",
          "description": "Name or title of holiday"
        },
        "jenis": {
          "type": "string",
          "enum": ["libur_nasional", "cuti_bersama"],
          "description": "Type: libur_nasional or cuti_bersama"
        },
        "keterangan": {
          "type": "string",
          "description": "Additional note or government decree"
        }
      },
      "required": ["tanggal", "nama", "jenis"]
    },
    "Permit": {
      "title": "Permit",
      "description": "Leave, official duty outside (dinas luar), sick note, or permission requests submitted by employees and approved by admin",
      "type": "object",
      "properties": {
        "nip": {
          "type": "string",
          "description": "Employee NIP"
        },
        "nama": {
          "type": "string",
          "description": "Employee full name"
        },
        "unit_kerja": {
          "type": "string",
          "description": "Work unit / Bagian in Setda"
        },
        "jenis": {
          "type": "string",
          "enum": ["dinas_luar", "sakit", "izin", "cuti"],
          "description": "Type of permit: dinas_luar, sakit, izin, cuti"
        },
        "tanggal_mulai": {
          "type": "string",
          "description": "Start date of permit YYYY-MM-DD"
        },
        "tanggal_selesai": {
          "type": "string",
          "description": "End date of permit YYYY-MM-DD"
        },
        "jumlah_hari": {
          "type": "number",
          "description": "Total business/effective days requested"
        },
        "keterangan": {
          "type": "string",
          "description": "Detailed explanation or task objective"
        },
        "nomor_surat": {
          "type": "string",
          "description": "Official letter / SPT / Doctor note number"
        },
        "lampiran_url": {
          "type": "string",
          "description": "Attachment image or PDF data URI / storage URL"
        },
        "lampiran_nama": {
          "type": "string",
          "description": "File name of attachment"
        },
        "is_susulan": {
          "type": "boolean",
          "description": "Flag indicating if permit was submitted retroactively"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status"
        },
        "catatan_admin": {
          "type": "string",
          "description": "Admin review notes or rejection reason"
        },
        "approved_by": {
          "type": "string",
          "description": "Email of admin who approved or rejected"
        },
        "approved_at": {
          "type": "string",
          "description": "ISO timestamp of review action"
        },
        "created_at": {
          "type": "string",
          "description": "ISO timestamp of submission"
        }
      },
      "required": ["nip", "nama", "jenis", "tanggal_mulai", "tanggal_selesai", "status"]
    },
    "EmployeeAuth": {
      "title": "EmployeeAuth",
      "description": "Authentication credentials and custom PIN for employee private portal",
      "type": "object",
      "properties": {
        "nip": {
          "type": "string",
          "description": "Employee NIP identifier"
        },
        "pin": {
          "type": "string",
          "description": "Secure PIN or passcode"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO timestamp of last PIN update"
        }
      },
      "required": ["nip", "pin"]
    },
    "AtasanUser": {
      "title": "AtasanUser",
      "description": "Supervisor and department head credentials with PIN for permit approval workflow",
      "type": "object",
      "properties": {
        "nip": {
          "type": "string",
          "description": "Supervisor NIP identifier"
        },
        "nama": {
          "type": "string",
          "description": "Supervisor full name"
        },
        "jabatan": {
          "type": "string",
          "description": "Official title or position"
        },
        "unit_kerja": {
          "type": "string",
          "description": "Work unit or Bagian in Setda Demak"
        },
        "pin": {
          "type": "string",
          "description": "Secure 6-digit access PIN"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["nip", "nama", "jabatan", "unit_kerja"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin accounts with management privileges"
    },
    "/settings/{settingId}": {
      "schema": "WorkHours",
      "description": "General application settings including work hours"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master data of employees keyed by NIP"
    },
    "/employee_auth/{nip}": {
      "schema": "EmployeeAuth",
      "description": "Security credentials and custom access PIN per employee"
    },
    "/atasan_users/{atasanId}": {
      "schema": "AtasanUser",
      "description": "Department heads and direct supervisors with authentication PIN"
    },
    "/attendances/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance transaction logs imported from fingerprint machines"
    },
    "/holidays/{holidayId}": {
      "schema": "Holiday",
      "description": "National holidays and collective leave days"
    },
    "/permits/{permitId}": {
      "schema": "Permit",
      "description": "Employee leave, official duty (dinas luar), and sick note requests with approval workflow"
    }
  }
}
